print "=== Language tour ===";

var total = 0;
for (var i = 1; i <= 4; i = i + 1) {
  total = total + i;
}
print total;

fun makeCounter() {
  var count = 0;

  fun next() {
    count = count + 1;
    return count;
  }

  return next;
}

var counter = makeCounter();
print counter();
print counter();

class Greeter {
  init(name) {
    this.name = name;
  }

  greet() {
    print "Hello, " + this.name + "!";
  }
}

Greeter("Lox").greet();